# 密钥与环境配置（绝不提交）
.env

# Python 运行产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# 虚拟环境
.venv/
venv/

# 运行时数据（向量库 / 会话记忆 / 缓存 / 日志，删除即重置）
data/
*.sqlite
*.sqlite-*

# 日志
*.log

# 编辑器
.idea/
.vscode/

# Node / Electron 客户端
node_modules/
apps/deskpet/desktop/node_modules/
apps/deskpet/desktop/dist/
npm-debug.log*

# 系统文件
Thumbs.db
desktop.ini

# 内部过程留档（施工指令 / 上传清单 / TRAE 规则），只在本机保存，不随公开仓库发布
/.trae/
/docs/阶段*.md
/docs/上传GitHub_分批commit清单.md

# 会话验收清单与原始输出（含本地跑测日志，仅本机留档，不随公开仓库发布）
/docs/会话*_验收清单.md
/docs/会话*_原始输出/
