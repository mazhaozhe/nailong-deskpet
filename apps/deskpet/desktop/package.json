{
  "name": "nailong-deskpet-client",
  "version": "1.0.0",
  "private": true,
  "description": "奶龙桌宠桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "test": "node --test ../../../tests/desktop/test_pet_drag.cjs ../../../tests/desktop/test_petex_drag.cjs ../../../tests/desktop/test_native_click.cjs ../../../tests/desktop/test_game_ui.cjs",
    "test:window": "electron ../../../tests/desktop/test_pet_drag_electron.cjs"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nailong.deskpet",
    "productName": "奶龙桌宠",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "native-click.js",
      "native_mouse.py",
      "vendor/petex/drag.cjs",
      "vendor/petex/LICENSE",
      "vendor/petex/SOURCE.md",
      "assets/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
