{
  "name": "nailong-deskpet-client",
  "version": "1.0.0",
  "private": true,
  "description": "奶龙桌宠桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "runtime": "node scripts/assemble-runtime.mjs",
    "prepack": "node scripts/assemble-runtime.mjs",
    "pack": "electron-builder --dir",
    "predist": "node scripts/assemble-runtime.mjs",
    "dist": "electron-builder --win nsis",
    "test": "node --test ../../../tests/desktop/test_pet_drag.cjs ../../../tests/desktop/test_petex_drag.cjs ../../../tests/desktop/test_native_click.cjs ../../../tests/desktop/test_actions.cjs",
    "test:window": "electron ../../../tests/desktop/test_pet_drag_electron.cjs"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.nailong.deskpet",
    "productName": "奶龙桌宠",
    "directories": {
      "output": "dist"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "main.js",
      "preload.js",
      "native-click.js",
      "native_mouse.py",
      "approval-dialog.html",
      "approval-dialog-preload.js",
      "key-dialog.html",
      "key-dialog-preload.js",
      "vendor/petex/drag.cjs",
      "vendor/petex/LICENSE",
      "vendor/petex/SOURCE.md",
      "assets/**/*",
      "renderer/**/*",
      "package.json",
      "!**/.env"
    ],
    "extraResources": [
      {
        "from": "../../..",
        "to": "approot",
        "filter": [
          "apps/deskpet/backend/**/*",
          "apps/deskpet/desktop/renderer/**/*",
          "apps/deskpet/desktop/assets/**/*",
          "apps/deskpet/desktop/native_mouse.py",
          "apps/agent/**/*",
          "infrastructure/**/*",
          "config/**/*",
          "requirements.txt",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/*.log",
          "!**/.env",
          "!**/data/**",
          "!**/logs/**",
          "!**/*.sqlite*"
        ]
      },
      {
        "from": "build-runtime/runtime",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}
